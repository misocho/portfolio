# Umami Cloud analytics (https://cloud.umami.is).
# Paste the Website ID from your Umami dashboard to enable analytics. When this
# is unset, no analytics script is loaded and no requests are made.
# In CI this value comes from the VITE_UMAMI_WEBSITE_ID repository Variable.
VITE_UMAMI_WEBSITE_ID=

# Optional: override the tracker script URL (e.g. a self-hosted Umami instance).
# Defaults to https://cloud.umami.is/script.js
# VITE_UMAMI_SRC=

# Optional: comma-separated hostnames allowed to be tracked.
# Defaults to misocho.github.io, so local development is never recorded.
# VITE_UMAMI_DOMAINS=
